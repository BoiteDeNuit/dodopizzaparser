# --- Telegram bots ---
# Основной (пользовательский) бот: его получают пользователи, в нём кнопка WebApp
BOT_TOKEN=PUT_USER_BOT_TOKEN_HERE

# Админский бот: отдельный бот для команды /update и статистики
ADMIN_BOT_TOKEN=PUT_ADMIN_BOT_TOKEN_HERE

# Список username/ID администраторов через запятую (без @)
ADMIN_USERNAMES=golden_wreath
ADMIN_IDS=

# --- WebApp ---
# HTTPS URL, по которому Telegram будет открывать мини-приложение.
# Локально через https://<твой_ngrok_url>.ngrok-free.app
WEBAPP_URL=https://example.com

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Парсер ---
# Город Додо Пицца (slug из URL: https://dodopizza.ru/moscow → moscow)
DODO_CITY=moscow
# Кол-во запусков парсера в сутки (равномерно распределяется)
PARSER_RUNS_PER_DAY=4
# Headful режим обязателен для обхода Cloudflare
PARSER_HEADLESS=false

# --- Прокси (опционально, для парсера) ---
# PROXY=socks5://127.0.0.1:1080

# --- БД ---
DATABASE_URL=sqlite+aiosqlite:///./dodo_menu.db
